# PocketSmart AI Environment Configuration

# Flask Secret Key
SECRET_KEY=pocketsmart_super_secure_secret_key_change_in_production_2026

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pocketsmart

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Port and Debug Mode
PORT=5000
FLASK_DEBUG=True
