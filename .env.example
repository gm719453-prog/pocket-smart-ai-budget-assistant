# =============================================================
# PocketSmart AI — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.
# =============================================================

# Flask Secret Key — change to a long random string in production
SECRET_KEY=your_super_secret_random_key_here_change_this

# =============================================================
# MySQL Database Configuration
# For production: use your cloud MySQL host (e.g. PlanetScale, Railway, Clever Cloud)
# =============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=pocketsmart

# =============================================================
# Google Gemini API Key
# Obtain from: https://aistudio.google.com/
# =============================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model name (default: gemini-2.0-flash — change if needed)
GEMINI_MODEL=gemini-3.8-flash

# =============================================================
# Google OAuth 2.0 Credentials
# From Google Cloud Console: https://console.cloud.google.com/
# Add authorized redirect URI: https://YOUR-DOMAIN/auth/google/callback
# =============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =============================================================
# Server Configuration
# =============================================================
# PORT is set automatically by hosting platforms (Render, Heroku, etc.)
# Do NOT hard-code this in production.
PORT=5000

# Set FLASK_DEBUG=True ONLY for local development. NEVER in production.
FLASK_DEBUG=True

# Set SESSION_COOKIE_SECURE=True in production (requires HTTPS)
SESSION_COOKIE_SECURE=False
